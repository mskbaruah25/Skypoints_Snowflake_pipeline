# Local demo configuration, tracked in Git at the project owner's request.
# Local service credentials are included in Git history.
# Keep real Snowflake credentials in an ignored .env.local or shell environment.

# Host ports are fixed in compose.yaml: Airflow 18080, MinIO API 19000,
# MinIO console 19001. All bind to 127.0.0.1.

# Airflow metadata PostgreSQL (not the business-data warehouse).
# Local demo login: admin / admin.
AIRFLOW_DB_PASSWORD=admin

# Generate a valid Fernet key, plus two independent random shared secrets.
AIRFLOW_FERNET_KEY=AWHGqerA0H-xVlV1w26tpCSwCDjgzHprjnD2EQM-TlE=
AIRFLOW_API_SECRET_KEY=lLJUdE2Xz6ihXZfOuXoFB7dDkiMJEGVK1xSuosMzOMnYeCvrUbpnSVcLLHfjBrxh
AIRFLOW_JWT_SECRET=74m16uS_4dd_9riYxzP8Su1QWi7vc-ZR-3KcLB44yMepAtmMu2rxeMsizXIEllaZ

# One shared local demo login; bootstrap synchronises existing passwords too.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_REVIEWER_USERNAME=admin
AIRFLOW_REVIEWER_PASSWORD=admin
AIRFLOW_TRIGGER_USERNAME=admin
AIRFLOW_TRIGGER_PASSWORD=admin

# MinIO local-demo credentials. Hosted deployment uses a scoped ingestion identity.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_BUCKET=skypoints-landing
# The receiver verifies this exact Authorization header value.
MINIO_WEBHOOK_AUTHORIZATION='Bearer ALpqlaKv4H8-tkmXvuZy-G7KoGuH91__4MZn0r_JHQ2Pj33ARVCZQt4hL5C6loRF'

# Existing Snowflake objects and a dedicated pipeline identity.
# Snowflake object provisioning is an explicit separate setup step.
SNOWFLAKE_ACCOUNT=REPLACE_ORGANIZATION-ACCOUNT
SNOWFLAKE_USER=REPLACE_PIPELINE_USER
SNOWFLAKE_ROLE=REPLACE_PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=REPLACE_EXISTING_WAREHOUSE
SNOWFLAKE_DATABASE=SKYPOINTS
# Host directory mounted read-only at /run/secrets in the scheduler.
SNOWFLAKE_SECRETS_DIR=./secrets
# Container path; add the key when warehouse tasks are configured.
SNOWFLAKE_PRIVATE_KEY_FILE=/run/secrets/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Generator source stays outside skypoints-pipeline/ and outside its Git tree.
# This folder must contain app/generate.py, requirements.txt, .dockerignore, and input/.
DATA_GENERATOR_DIR=../data-generator
GENERATOR_BATCH_ID=demo-001
GENERATOR_SEED=42
GENERATOR_MEMBER_COUNT=100
# Fixed for reproducible example runs; not implicitly replaced with today's date.
GENERATOR_AS_OF_DATE=2026-11-21
AIRFLOW_DB_USERNAME=admin
