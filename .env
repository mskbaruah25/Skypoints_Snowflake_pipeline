# Existing Snowflake objects and a dedicated pipeline identity.
# Snowflake object provisioning is an explicit separate setup step.
SNOWFLAKE_ACCOUNT=REPLACE_ORGANIZATION-ACCOUNT
SNOWFLAKE_USER=REPLACE_PIPELINE_USER
SNOWFLAKE_ROLE=REPLACE_PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=REPLACE_EXISTING_WAREHOUSE
SNOWFLAKE_DATABASE=SKYPOINTS
SNOWFLAKE_PRIVATE_KEY_FILE=./secrets/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Generator source stays outside skypoints-pipeline/ and outside its Git tree.
# This folder must contain app/generate.py, requirements.txt, .dockerignore, and input/.
DATA_GENERATOR_DIR=../data-generator
GENERATOR_BATCH_ID=demo-001
GENERATOR_SEED=42
GENERATOR_MEMBER_COUNT=100
# Fixed for reproducible example runs; not implicitly replaced with today's date.
GENERATOR_AS_OF_DATE=2026-11-21
