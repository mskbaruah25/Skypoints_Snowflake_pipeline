# No values below are real credentials. Copy this template to .env.
# Generate replacements before any startup. Keep .env and private keys private.

# Local ports; Compose binds these to 127.0.0.1.
AIRFLOW_UI_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Airflow metadata PostgreSQL (not the business-data warehouse).
# Use a generated URL-safe password here because it is embedded in a DB URI.
AIRFLOW_DB_PASSWORD=REPLACE_WITH_GENERATED_URL_SAFE_PASSWORD

# Generate a valid Fernet key, plus two independent random shared secrets.
AIRFLOW_FERNET_KEY=REPLACE_WITH_VALID_FERNET_KEY
AIRFLOW_API_SECRET_KEY=REPLACE_WITH_RANDOM_API_SECRET
AIRFLOW_JWT_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_JWT_SECRET

# bootstrap_airflow.py creates these idempotently using FAB roles.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
AIRFLOW_REVIEWER_USERNAME=reviewer
AIRFLOW_REVIEWER_PASSWORD=REPLACE_WITH_REVIEWER_PASSWORD
AIRFLOW_TRIGGER_USERNAME=minio-trigger
AIRFLOW_TRIGGER_PASSWORD=REPLACE_WITH_TRIGGER_SERVICE_PASSWORD

# MinIO local-demo credentials. Hosted deployment uses a scoped ingestion identity.
MINIO_ROOT_USER=skypoints-local-admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_PASSWORD
MINIO_BUCKET=skypoints-landing
# The receiver verifies this exact Authorization header value.
MINIO_WEBHOOK_AUTHORIZATION='Bearer REPLACE_WITH_RANDOM_WEBHOOK_TOKEN'

# Existing Snowflake objects and a dedicated pipeline identity.
# Snowflake object provisioning is an explicit separate setup step.
SNOWFLAKE_ACCOUNT=REPLACE_ORGANIZATION-ACCOUNT
SNOWFLAKE_USER=REPLACE_PIPELINE_USER
SNOWFLAKE_ROLE=REPLACE_PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=REPLACE_EXISTING_WAREHOUSE
SNOWFLAKE_DATABASE=SKYPOINTS
SNOWFLAKE_PRIVATE_KEY_FILE=./secrets/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Generator source stays outside skypoints-pipeline/ and outside its Git tree.
# This folder must contain app/generate.py, requirements.txt, .dockerignore, and input/.
DATA_GENERATOR_DIR=../data-generator
GENERATOR_BATCH_ID=demo-001
GENERATOR_SEED=42
GENERATOR_MEMBER_COUNT=100
# Fixed for reproducible example runs; not implicitly replaced with today's date.
GENERATOR_AS_OF_DATE=2026-11-21
